{
  "$schema": "./node_modules/@iwsdk/core/dist/schemas/iwsdk-project.v1.schema.json",
  "version": "iwsdk.project.v1",
  "scene": "./public/scenes/main.iwsdk.scene.json",
  "assets": {
    "module": "./src/assets"
  },
  "components": {
    "module": "./src/components"
  },
  "world": {
    "xr": {
      "mode": "ar",
      "offer": "always",
      "features": {
        "handTracking": true,
        "anchors": true,
        "hitTest": true,
        "planeDetection": true,
        "depthSensing": {
          "required": true,
          "usage": "gpu-optimized",
          "format": "float32"
        }
      }
    },
    "input": {
      "canvasPointerEvents": true
    },
    "render": {
      "fov": 62,
      "near": 0.01,
      "far": 120,
      "camera": {
        "position": [0, 1.44, 0.56],
        "lookAt": [0, 0.98, -0.58]
      }
    },
    "features": {
      "locomotion": false,
      "grabbing": true,
      "physics": false,
      "sceneUnderstanding": {
        "showWireFrame": false
      },
      "environmentRaycast": true,
      "spatialUI": {
        "kit": "horizon",
        "preferredColorScheme": "dark"
      }
    }
  },
  "dev": {
    "emulator": {
      "device": "metaQuest3",
      "environment": "sunlit_living_room"
    }
  }
}
